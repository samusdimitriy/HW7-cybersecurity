p adapter decodes the entire payload into memory (`Buffer`/`Blob`) and returns a synthetic 200 response. This path ignores `maxContentLength` / `maxBodyLength` (which only protect HTTP responses), so an attacker can supply a very large `data:` URI and cause the process to allocate unbounded memory and crash (DoS), even if the caller requested `responseType: 'stream'`. Versions 0.30.2 and 1.12.0 contain a patch for the issue.","cvss":[{"source":"security-advisories@github.com","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:N/A:H","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2025-58754","epss":0.00026,"percentile":0.06682,"date":"2026-01-02"}],"cwes":[{"cve":"CVE-2025-58754","cwe":"CWE-770","source":"security-advisories@github.com","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"axios","version":"0.21.1"}},"found":{"vulnerabilityID":"GHSA-4hjh-wcwx-xvwj","versionConstraint":"<0.30.2 (semantic)"},"fix":{"suggestedVersion":"0.30.2"}}],"artifact":{"id":"pkg:npm/axios@0.21.1?package-id=41a13efd1e3f2967","name":"axios","version":"0.21.1","type":"npm","locations":[{"path":"/package-lock.json","accessPath":""}],"language":"javascript","licenses":["MIT"],"cpes":["cpe:2.3:a:axios:axios:0.21.1:*:*:*:*:node.js:*:*"],"purl":"pkg:npm/axios@0.21.1","upstreams":[]}}],"source":{"type":"file","target":"."},"distro":{"name":"","version":"","idLike":null},"descriptor":{"name":"grype","version":"0.104.3","configuration":{"output":["json"],"file":"","pretty":false,"distro":"","add-cpes-if-none":false,"output-template-file":"","check-for-app-update":true,"only-fixed":false,"only-notfixed":false,"ignore-wontfix":"","platform":"","search":{"scope":"squashed","unindexed-archives":false,"indexed-archives":true},"ignore":[{"vulnerability":"","i